---
const clients = Astro.locals.content.clients.filter((item) => item.visible);
const showHousing = Astro.locals.content.showHousing;
---

{(clients.length > 0 || showHousing) && (
  <section id="klien" class="section" aria-labelledby="clients-title">
    <div class="container">
      <p class="eyebrow">KLIEN KAMI</p>
      <h2 id="clients-title">Bertumbuh bersama mitra kami.</h2>
      <div class="client-grid">
        {clients.map((client) => (
          <div>
            <img
              src={client.src}
              alt={client.alt}
              width={client.width}
              height={client.height}
              loading="lazy"
              decoding="async"
            />
          </div>
        ))}
        {showHousing && (
          <div class="client-category">
            <span>Hunian & Properti</span>
            <strong>Kos-kosan</strong>
          </div>
        )}
      </div>
    </div>
  </section>
)}
